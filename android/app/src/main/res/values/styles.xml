<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <!-- The running activity theme (BridgeActivity applies it after the splash). The wallet
         is dark by default, so the system bars and the window behind the WebView must be
         too: a DayNight parent painted the status bar AppCompat's light-mode grey. -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowBackground">#050806</item>
        <!-- Ignored from targetSdk 35: Android 15 enforces edge-to-edge and the app
             draws behind both bars. Kept for Android 14 and below, where they still
             apply. What keeps content clear of the bars on 15+ is the web layer's
             env(safe-area-inset-*) padding, which needs viewport-fit=cover in
             index.html — both are in place. -->
        <item name="android:statusBarColor">#050806</item>
        <item name="android:navigationBarColor">#050806</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>


    <!-- The launch theme.
         It inherits from AppTheme.NoActionBar, and that inheritance IS the fix.

         This used to be parent="Theme.SplashScreen" (androidx core-splashscreen). That
         theme only stops being the activity's theme when installSplashScreen() runs and
         swaps in postSplashScreenTheme — and nothing in this app calls it, because
         BridgeActivity does not. So the activity kept a DeviceDefault-based theme for the
         whole session, action bar and all, which drew android:label ("ZKas Wallet") in a
         bar across the top of the wallet in the system's colours. Adding
         postSplashScreenTheme alone did not help: there was still no call to apply it.

         Inheriting from the real theme needs no library and no call. windowNoTitle and
         windowActionBar=false are inherited, so there is no bar to draw at any point in
         the launch, and the splash art is simply the window background until the WebView
         paints over it. -->
    <style name="AppTheme.NoActionBarLaunch" parent="AppTheme.NoActionBar">
        <item name="android:windowBackground">@drawable/splash</item>
        <item name="android:windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>
</resources>