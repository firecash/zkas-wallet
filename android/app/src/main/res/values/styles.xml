<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <!-- The running activity theme (BridgeActivity applies it after the splash). The wallet
         is dark by default, so the system bars and the window behind the WebView must be
         too: a DayNight parent painted the status bar AppCompat's light-mode grey. -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowBackground">#08080c</item>
        <!-- Ignored from targetSdk 35: Android 15 enforces edge-to-edge and the app
             draws behind both bars. Kept for Android 14 and below, where they still
             apply. What keeps content clear of the bars on 15+ is the web layer's
             env(safe-area-inset-*) padding, which needs viewport-fit=cover in
             index.html — both are in place. -->
        <item name="android:statusBarColor">#08080c</item>
        <item name="android:navigationBarColor">#08080c</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
    </style>
</resources>