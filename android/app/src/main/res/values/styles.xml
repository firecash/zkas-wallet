<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <!-- The running activity theme (BridgeActivity applies it after the splash). The wallet
         is dark by default, so the system bars and the window behind the WebView must be
         too: a DayNight parent painted the status bar AppCompat's light-mode grey. -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowBackground">#050806</item>
        <!-- Ignored from targetSdk 35: Android 15 enforces edge-to-edge and the app
             draws behind both bars. Kept for Android 14 and below, where they still
             apply. What keeps content clear of the bars on 15+ is the web layer's
             env(safe-area-inset-*) padding, which needs viewport-fit=cover in
             index.html — both are in place. -->
        <item name="android:statusBarColor">#050806</item>
        <item name="android:navigationBarColor">#050806</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>


    <!-- The launch theme, and the ONE item that makes it hand over.
         Theme.SplashScreen (androidx core-splashscreen) is a LAUNCH theme: it is meant to
         be replaced the moment the app draws. The replacement is named by
         `postSplashScreenTheme`, and that item was missing. Without it the Activity keeps
         this theme for the whole session -- including its default title bar, which renders
         android:label ("ZKas Wallet") truncated to "ZKas..." beside the app icon, in the
         system's own bar colour rather than ours. That is the strip reported on Android,
         with @drawable/splash still painted behind it because `android:background` is not
         the property this theme draws from either.
         The splash image and colour belong in the windowSplashScreen* items. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#050806</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>