{
  "name": "zkas-wallet",
  "private": true,
  "version": "1.0.1",
  "description": "Shielded web wallet for ZKas \u2014 a thin React/Vite SPA over the zkas-walletd daemon.",
  "license": "ISC",
  "homepage": "https://wallet.zkas.info",
  "repository": {
    "type": "git",
    "url": "https://github.com/firecash/zkas-wallet.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "mobile:add:android": "cap add android",
    "mobile:add:ios": "cap add ios",
    "mobile:sync": "npm run build && cap sync && npm run check:signer",
    "mobile:android": "npm run build && cap sync android && npm run check:signer && cap open android",
    "mobile:ios": "npm run build && cap sync ios && npm run check:signer && cap open ios",
    "lint": "eslint src",
    "test": "eslint src && vitest run",
    "check:signer": "node scripts/check-signer-genesis.mjs ${ZKAS_GENESIS:-b63f7fe8e50402af34790265e299bb1ba63e943b91a59a670e5971b7a9e84e6f}"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/core": "^6.2.0",
    "@capacitor/haptics": "^6.0.3",
    "@capacitor/ios": "^6.2.0",
    "@tauri-apps/api": "^2.11.1",
    "jsqr": "^1.4.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0",
    "@typescript-eslint/parser": "^8.64.0",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^29.1.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.15",
    "vitest": "^2.1.9"
  }
}
