<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
        <string>ZKas Wallet</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
	<!-- The on-device engine serves the app over plain HTTP on 127.0.0.1, because the
	     listener is inside this process and never touches a network. App Transport
	     Security blocks cleartext by default, which would make "Run on this phone" fail
	     with no obvious cause.

	     NSAllowsLocalNetworking is the narrow exception for exactly this: loopback and
	     local-network HTTP are permitted, every other cleartext connection stays blocked.
	     NSAllowsArbitraryLoads would also work and is wrong — it would disable ATS for
	     the whole app, including the public node and the price feed.

	     The WebView origin (capacitor://localhost) is already in the engine's CORS
	     allow-list, alongside the Android ones. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- REQUIRED, and not merely for politeness: iOS terminates the process when an app
	     touches privacy-sensitive hardware without a usage string. The QR scanner calls
	     getUserMedia inside the WebView and the app lock evaluates Face ID, so without
	     these two the app crashes the first time a user scans a code or unlocks — and
	     the submission is rejected. Android declares the matching CAMERA and
	     USE_BIOMETRIC permissions.

	     Written to say what the access is FOR. These strings are what the user reads in
	     the system prompt, and "needs camera access" tells them nothing about whether to
	     trust it with a wallet. -->
	<key>NSCameraUsageDescription</key>
	<string>ZKas Wallet uses the camera only to scan payment QR codes. Frames are decoded on this device and never sent anywhere.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>ZKas Wallet uses Face ID to unlock the app and to protect your recovery phrase on this device.</string>
	<!-- Payment links and the share sheet. Android registers the same two schemes plus a
	     text/plain share target; without this iOS does nothing when a zkas: link is
	     tapped. The AppDelegate already forwards openURL and universal links to
	     Capacitor, so only the declaration was missing. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>info.zkas.wallet</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>zkas</string>
				<string>zkas-wallet</string>
			</array>
		</dict>
	</array>
	<!-- The app is dark-only: boot() clears any stored theme preference and the light
	     palette was dropped. Declaring it here is what makes iOS draw light status-bar
	     content; left unset, iOS follows the SYSTEM appearance while the app stays dark,
	     so a phone in light mode got dark text on the app's near-black background. -->
	<key>UIUserInterfaceStyle</key>
	<string>Dark</string>
</dict>
</plist>
