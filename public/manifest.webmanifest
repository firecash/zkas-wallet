{
  "name": "ZKas Wallet",
  "short_name": "ZKas",
  "description": "Shielded-by-default ZKas wallet — private balances, private payments.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "id": "/",
  "orientation": "any",
  "categories": ["finance", "utilities"],
  "background_color": "#0b0b0f",
  "theme_color": "#0b0b0f",
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/icon-512-maskable.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Receive ZKAS", "short_name": "Receive", "url": "/#/tools?tab=request", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "Explore network", "short_name": "Explore", "url": "/#/explore", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "Mining", "short_name": "Mine", "url": "/#/mine", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] }
  ],
  "protocol_handlers": [
    { "protocol": "web+zkas", "url": "/?payment=%s" }
  ]
}
